# Documentation ranges only: nothing here comes from a lab handout.
POOL=198.51.100.0/27
INSIDE=172.16.10.0/24
INSIDE_ALL=172.16.0.0/16
CLIENT_IP=172.16.10.2
SERVER_IP=203.0.113.9
SERVER_NET=203.0.113.0/24
EXEMPT_IP=172.16.50.1
EXEMPT_NET=172.16.50.0/24

# Point to point links, one /30 each: <client side> <nat side>
CA_CLIENT=192.0.2.1;  CA_NAT=192.0.2.2
CB_CLIENT=192.0.2.5;  CB_NAT=192.0.2.6
SA_SERVER=192.0.2.9;  SA_NAT=192.0.2.10
SB_SERVER=192.0.2.13; SB_NAT=192.0.2.14
SYNC_A=192.0.2.17;    SYNC_B=192.0.2.18

# IPv6-only client reaching IPv4 servers through the NAT64 prefix
CLIENT_IP6=2001:db8:10::2
CA6_CLIENT=2001:db8:a::1;  CA6_NAT=2001:db8:a::2
NAT64_PREFIX=64:ff9b::/96
SERVER_IP6=64:ff9b::cb00:7109

HTTP_PORT=8000
UDP_PORT=7007
TLS_PORT=4433
STREAM_PORT=9000
SYNC_PORT=9999
